<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Dashboard-Calculator-v21</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="index.html" />
    <None Remove="ford.html" />
    <None Remove="isuzu.html" />
    <EmbeddedResource Include="index.html" LogicalName="index.html" />
    <EmbeddedResource Include="ford.html" LogicalName="ford.html" />
    <EmbeddedResource Include="isuzu.html" LogicalName="isuzu.html" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2151.40" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>